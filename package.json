{
	"name": "node-template",
	"version": "1.0.0",
	"description": "Node.js template",
	"main": "dist/index.js",
	"scripts": {
		"start": "node --no-warnings=ExperimentalWarning --watch --import=tsx lib/index.ts",
		"build": "tsc lib/index.ts --outDir dist",
		"test": "jest --no-watchman --maxWorkers=80%",
		"test-watch": "jest --watch --maxWorkers=80%",
		"coverage": "jest --coverage",
		"lint": "eslint 'lib/**/*.ts' && prettier 'lib/**/*.ts'",
		"lintfix": "eslint --fix 'lib/**/*.ts' && prettier --write 'lib/**/*.ts'",
		"update": "npm i npm-check-updates@latest --save-dev && ncu -u && npm i && npm audit fix && npm run lint && npm test",
		"prepare": "husky"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/romaleev/node-template.git"
	},
	"type": "module",
	"typedoc": {
		"entryPoint": "lib/index.ts"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"lint-staged": {
		"lib/**/*.ts": [
			"eslint --fix",
			"prettier --write"
		]
	},
	"keywords": [
		"node-template",
		"typescript",
		"eslint",
		"prettier"
	],
	"author": "Roman Malieiev <aromaleev@gmail.com>",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/romaleev/node-template/issues"
	},
	"homepage": "https://github.com/romaleev/node-template#readme",
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.14.0",
		"eslint": "^9.23.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-prettier": "^5.2.6",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"jiti": "^2.4.2",
		"lint-staged": "^15.5.0",
		"npm-check-updates": "^17.1.16",
		"prettier": "^3.5.3",
		"prettier-eslint": "^16.3.0",
		"prettier-plugin-organize-imports": "^4.1.0",
		"ts-jest": "^29.3.1",
		"tsx": "^4.19.3",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.29.0"
	}
}
