{
	"name": "node-template",
	"version": "1.0.0",
	"description": "Node.js template",
	"main": "dist/index.js",
	"scripts": {
		"start": "tsx watch lib/index.ts",
		"build": "tsc lib/index.ts --outDir dist",
		"test:run": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest run --coverage",
		"lint": "tsc && eslint --fix {lib/**/*.ts,*.ts} && prettier --write {lib/**/*.ts,*.ts}",
		"update": "pnpm add npm-check-updates@latest -D && ncu -u && pnpm i && pnpm audit fix && pnpm test:run",
		"prepare": "husky"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/romaleev/node-template.git"
	},
	"type": "module",
	"typedoc": {
		"entryPoint": "lib/index.ts"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"keywords": [
		"node-template",
		"typescript",
		"eslint",
		"prettier"
	],
	"author": "Roman Malieiev <aromaleev@gmail.com>",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/romaleev/node-template/issues"
	},
	"homepage": "https://github.com/romaleev/node-template#readme",
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@types/node": "^24.7.0",
		"@vitest/coverage-v8": "3.2.4",
		"eslint": "^9.37.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.4.0",
		"husky": "^9.1.7",
		"jiti": "^2.6.1",
		"npm-check-updates": "^19.0.0",
		"prettier": "^3.6.2",
		"prettier-eslint": "^16.4.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.0",
		"vite": "^7.1.9",
		"vitest": "^3.2.4"
	}
}
