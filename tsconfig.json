{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "esnext",
		"lib": [
			"esnext"
		],
		"allowJs": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"paths": {
			"#lib/*": [
				"lib/*"
			],
			"#tests/*": [
				"src/tests/*"
			]
		},
		"types": [
			"vitest/globals"
		]
	},
	"include": [
		"lib",
		"tests"
	]
}
